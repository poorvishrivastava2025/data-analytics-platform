# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your values
# ==============================================================================

# Application Branding & Server Configuration
PORT=3000
DATABASE_PATH=./analystpath.db
APP_NAME=Data Analyst Learning Platform
PUBLIC_URL=http://localhost:3000

# Authentication & Session Security
SESSION_SECRET=replace-with-a-random-secure-64-character-string

# Administrator Configuration (Optional)
# If provided, a user registering with this email address will automatically receive the 'admin' role.
# Alternatively, promote any existing user via CLI: node make-admin.js <user-email>
ADMIN_EMAIL=admin@example.com

# AI Tutor Integration (Optional)
# If provided, connects directly to Google Gemini 1.5 Pro / Flash.
# If omitted, transparently uses the built-in pedagogical rule & analogy engine.
GEMINI_API_KEY=your-gemini-api-key-here

# Real-Time WebRTC Audio / Video Calling (Optional)
# Google's public STUN is free and enabled by default for NAT traversal.
STUN_SERVER=stun:stun.l.google.com:19302
# TURN servers are required when users are behind symmetric corporate NATs / firewalls.
TURN_SERVER_URL=turn:your-turn-server.example.com:3478
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-password

# Email Delivery for Verification & Password Reset (Optional for production)
# In development, activation and reset links are printed directly to the server log
# and returned in API responses for zero-friction testing.
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@your-domain.mailgun.org
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@your-domain.com

# AI Teacher Video Generation & Avatar Providers (Optional)
# If omitted or unconfigured, lessons run in interactive AI Teacher Studio mode
# with live Web Speech TTS narration (English & Hindi) and synchronized visual stages.
# When provided, production MP4 avatar videos can be rendered or ingested.
HEYGEN_API_KEY=your-heygen-api-key-here
DID_API_KEY=your-did-api-key-here
SYNTHESIA_API_KEY=your-synthesia-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
VIDEO_WEBHOOK_SECRET=your-webhook-secret-here
